# 大模型：支持任意 OpenAI 兼容接口（DeepSeek、Moonshot/Kimi、OpenAI 等）
# 当前使用 Moonshot Kimi-2.7，模型名按你实际开通的填写，如 kimi-k2-7
LLM_API_KEY=sk-这里填你的key
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2-7

# 兼容旧变量名（不建议新项目使用）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# Embedding 模型（本地 BGE 中文模型）
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 分块 / 检索参数（分块按段落切，CHUNK_SIZE 是合并上限）
CHUNK_SIZE=200
CHUNK_OVERLAP=50
TOP_N=3
SIM_THRESHOLD=0.6

# 向量库数据存放目录（numpy 本地存储）
STORE_DIR=./vector_store

# SQLite（结构化数据，如通讯录）
SQLITE_PATH=./sqlite_db/contacts.db

# Agent 循环最大轮数（防死循环）
MAX_AGENT_ROUNDS=5
